{% extends 'base.html.twig' %}

{% block title %}Gestion des Messages{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
{% endblock %}

{% block body %}
    <div class="admin-header">
        <h1 class="h3 mb-0">Messages reçus</h1>
    </div>

    <div class="table-responsive">
        <table class="table-admin">
            <thead>
                <tr>
                    <th>Statut</th>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Message</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for message in messages %}
                <tr>
                    <td>
                        {% if message.lu %}
                            <span class="badge text-bg-secondary">Lu</span>
                        {% else %}
                            <span class="badge text-bg-primary">Nouveau</span>
                        {% endif %}
                    </td>
                    <td>{{ message.nom }}</td>
                    <td>{{ message.email }}</td>
                    <td>{{ message.contenu|slice(0, 60) }}{% if message.contenu|length > 60 %}...{% endif %}</td>
                    <td>{{ message.dateEnvoi ? message.dateEnvoi|date('d/m/Y H:i') : '' }}</td>
                    <td>
                        <div class="actions-cell">
                            <a href="{{ path('app_message_show', {'id': message.id}) }}" class="btn btn-outline-secondary btn-sm">Voir</a>
                            <a href="{{ path('app_message_edit', {'id': message.id}) }}" class="btn btn-outline-primary btn-sm">Modifier</a>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="text-center text-secondary">Aucun message reçu</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}