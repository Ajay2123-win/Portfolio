{% extends 'base.html.twig' %}

{% block title %}Détail du Message{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
{% endblock %}

{% block body %}
    <div class="admin-header">
        <h1 class="h3 mb-0">Message #{{ message.id }}</h1>
        <a href="{{ path('app_message_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
    </div>

    <div class="show-panel mb-3">
        <table>
            <tbody>
                <tr><th>Id</th><td>{{ message.id }}</td></tr>
                <tr><th>Nom</th><td>{{ message.nom }}</td></tr>
                <tr><th>Email</th><td>{{ message.email }}</td></tr>
                <tr><th>Message</th><td>{{ message.contenu }}</td></tr>
                <tr><th>Date d'envoi</th><td>{{ message.dateEnvoi ? message.dateEnvoi|date('d/m/Y H:i') : '' }}</td></tr>
                <tr><th>Lu</th><td>{{ message.lu ? 'Oui' : 'Non' }}</td></tr>
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_message_edit', {'id': message.id}) }}" class="btn btn-primary">Modifier</a>
{% endblock %}