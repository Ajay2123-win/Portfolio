{% extends 'base.html.twig' %}

{% block title %}Gestion du Profil{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
{% endblock %}

{% block body %}
    <div class="admin-header">
        <h1 class="h3 mb-0">Profil</h1>
        <a href="{{ path('app_profil_new') }}" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Nouveau profil
        </a>
    </div>

    <div class="table-responsive">
        <table class="table-admin">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Titre</th>
                    <th>Email</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for profil in profils %}
                <tr>
                    <td>{{ profil.id }}</td>
                    <td>{{ profil.nom }}</td>
                    <td>{{ profil.prenom }}</td>
                    <td>{{ profil.titre }}</td>
                    <td>{{ profil.email }}</td>
                    <td>
                        <div class="actions-cell">
                            <a href="{{ path('app_profil_show', {'id': profil.id}) }}" class="btn btn-outline-secondary btn-sm">Voir</a>
                            <a href="{{ path('app_profil_edit', {'id': profil.id}) }}" class="btn btn-outline-primary btn-sm">Modifier</a>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="text-center text-secondary">Aucun profil trouvé</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}