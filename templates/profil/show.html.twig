{% extends 'base.html.twig' %}

{% block title %}Détail du Profil{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
{% endblock %}

{% block body %}
    <div class="admin-header">
        <h1 class="h3 mb-0">Profil #{{ profil.id }}</h1>
        <a href="{{ path('app_profil_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
    </div>

    <div class="show-panel mb-3">
        <table>
            <tbody>
                <tr><th>Id</th><td>{{ profil.id }}</td></tr>
                <tr><th>Nom</th><td>{{ profil.nom }}</td></tr>
                <tr><th>Prénom</th><td>{{ profil.prenom }}</td></tr>
                <tr><th>Titre</th><td>{{ profil.titre }}</td></tr>
                <tr><th>Email</th><td>{{ profil.email }}</td></tr>
                <tr><th>Téléphone</th><td>{{ profil.telephone }}</td></tr>
                <tr><th>Localisation</th><td>{{ profil.localisation }}</td></tr>
                <tr><th>Bio</th><td>{{ profil.bio }}</td></tr>
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_profil_edit', {'id': profil.id}) }}" class="btn btn-primary">Modifier</a>
{% endblock %}