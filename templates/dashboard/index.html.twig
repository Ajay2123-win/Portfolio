{% extends 'base.html.twig' %}

{% block title %}Dashboard - Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
{% endblock %}

{% block body %}
    <h1 class="mb-4">Tableau de bord</h1>

    <div class="row g-3">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="label">Visites totales</span>
                    <i class="bi bi-eye icone"></i>
                </div>
                <div class="valeur">{{ totalVisites }}</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="label">Visiteurs uniques</span>
                    <i class="bi bi-people icone"></i>
                </div>
                <div class="valeur">{{ visiteursUniques }}</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="label">Aujourd'hui</span>
                    <i class="bi bi-calendar-day icone"></i>
                </div>
                <div class="valeur">{{ visitesAujourdhui }}</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="label">Messages non lus</span>
                    <i class="bi bi-envelope icone"></i>
                </div>
                <div class="valeur">{{ nbMessagesNonLus }}</div>
            </div>
        </div>
    </div>

    <div class="section-dashboard">
        <h2>Visites des 7 derniers jours</h2>
        {% if visitesParJour is empty %}
            <p class="text-secondary">Aucune donnée pour le moment.</p>
        {% else %}
            {% set maxTotal = 1 %}
            {% for jour in visitesParJour %}
                {% if jour.total > maxTotal %}{% set maxTotal = jour.total %}{% endif %}
            {% endfor %}

            {% for jour in visitesParJour %}
                <div class="barre-visite">
                    <span class="jour-label">{{ jour.jour }}</span>
                    <div class="barre" style="width: {{ (jour.total / maxTotal * 300)|round }}px;"></div>
                    <span class="total">{{ jour.total }}</span>
                </div>
            {% endfor %}
        {% endif %}
    </div>

    <div class="section-dashboard">
        <h2>Pages les plus visitées</h2>
        {% if pagesPopulaires is empty %}
            <p class="text-secondary">Aucune donnée.</p>
        {% else %}
            <ul class="liste-pages">
                {% for page in pagesPopulaires %}
                    <li>
                        <span>{{ page.pageVisitee }}</span>
                        <strong>{{ page.total }}</strong>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}