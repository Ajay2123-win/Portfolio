{% extends 'base.html.twig' %}

{% block title %}Parcours - Portfolio{% endblock %}

{% block body %}
    <h1>Mon Parcours</h1>

    <div style="margin-top: 30px; border-left: 2px solid #30363d; padding-left: 30px;">
        {% for etape in parcours %}
            <div style="margin-bottom: 35px; position: relative;">
                <div style="position: absolute; left: -38px; top: 4px; width: 14px; height: 14px; border-radius: 50%; background-color: {{ etape.type == 'formation' ? '#58a6ff' : '#7ee787' }};"></div>

                <span style="font-size: 0.8rem; color: #8b949e;">
                    {{ etape.dateDebut|date('m/Y') }}
                    {% if etape.dateFin %} - {{ etape.dateFin|date('m/Y') }}{% else %} - Aujourd'hui{% endif %}
                </span>

                <h3 style="margin: 5px 0;">{{ etape.titre }}</h3>
                <p style="color: #8b949e; font-size: 0.9rem;">{{ etape.etablissement }}</p>

                {% if etape.description %}
                    <p style="margin-top: 8px; font-size: 0.9rem;">{{ etape.description }}</p>
                {% endif %}

                <span style="display: inline-block; margin-top: 8px; font-size: 0.75rem; padding: 3px 10px; border-radius: 10px; background-color: {{ etape.type == 'formation' ? '#1f6feb33' : '#23863633' }}; color: {{ etape.type == 'formation' ? '#58a6ff' : '#7ee787' }};">
                    {{ etape.type|capitalize }}
                </span>
            </div>
        {% else %}
            <p>Aucun parcours renseigné pour le moment.</p>
        {% endfor %}
    </div>
{% endblock %}