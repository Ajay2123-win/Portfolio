{% extends 'base.html.twig' %}

{% block title %}Parcours - Portfolio{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/parcours.css') }}">
{% endblock %}

{% block body %}
    <h1 class="mb-4">Mon Parcours</h1>

    <div class="timeline">
        {% for etape in parcours %}
            <div class="timeline-item">
                <span class="timeline-dot {{ etape.type }}"></span>

                <span class="timeline-periode">
                    {{ etape.dateDebut|date('m/Y') }}
                    {% if etape.dateFin %}
                        &ndash; {{ etape.dateFin|date('m/Y') }}
                    {% else %}
                        &ndash; Aujourd'hui
                    {% endif %}
                </span>

                <h3>{{ etape.titre }}</h3>
                <p class="etablissement">{{ etape.etablissement }}</p>

                {% if etape.description %}
                    <p class="description">{{ etape.description }}</p>
                {% endif %}

                <span class="badge-type {{ etape.type }}">{{ etape.type|capitalize }}</span>
            </div>
        {% else %}
            <p>Aucun parcours renseigné pour le moment.</p>
        {% endfor %}
    </div>
{% endblock %}