{% extends 'base.html.twig' %}

{% block title %}Projets - Portfolio{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/projets.css') }}">
{% endblock %}

{% block body %}
    <h1>Portfolio</h1>

    <div class="filtres">
        <a href="{{ path('app_projets_public') }}" class="{{ categorieActive is null ? 'active' : '' }}">Tous</a>
        <a href="{{ path('app_projets_public', {categorie: 'Full-Stack'}) }}" class="{{ categorieActive == 'Full-Stack' ? 'active' : '' }}">Full-Stack</a>
        <a href="{{ path('app_projets_public', {categorie: 'IA & Data'}) }}" class="{{ categorieActive == 'IA & Data' ? 'active' : '' }}">IA & Data</a>
        <a href="{{ path('app_projets_public', {categorie: 'Applications'}) }}" class="{{ categorieActive == 'Applications' ? 'active' : '' }}">Applications</a>
    </div>

    <div class="row g-4">
        {% for projet in projets %}
            <div class="col-md-6 col-xl-4">
                <div class="projet-card h-100">
                    {% if projet.image %}
                        <img src="{{ asset('uploads/projets/' ~ projet.image) }}" alt="{{ projet.titre }}">
                    {% endif %}
                    <div class="contenu">
                        <h3>{{ projet.titre }}</h3>
                        <p class="categorie">{{ projet.categorie }}</p>
                        {% if projet.lien %}
                            <a href="{{ projet.lien }}" class="lien-projet" target="_blank">
                                Voir le projet <i class="bi bi-arrow-right"></i>
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <p>Aucun projet pour cette catégorie.</p>
        {% endfor %}
    </div>
{% endblock %}