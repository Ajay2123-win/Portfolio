{% extends 'base.html.twig' %}

{% block title %}À propos - Portfolio{% endblock %}

{% block body %}
    <h1>À propos de moi</h1>

    {% if profil and profil.bio %}
        <p style="margin-top: 20px; line-height: 1.6; max-width: 700px;">{{ profil.bio }}</p>
    {% else %}
        <p>Aucune biographie renseignée pour le moment.</p>
    {% endif %}

    <h2 style="margin-top: 40px;">Compétences</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 15px;">
        {% for competence in competences %}
            <span style="background-color: #21262d; padding: 8px 16px; border-radius: 20px; font-size: 0.85rem;">
                {{ competence.nom }}
            </span>
        {% else %}
            <p>Aucune compétence renseignée.</p>
        {% endfor %}
    </div>
{% endblock %}