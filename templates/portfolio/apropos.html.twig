{% extends 'base.html.twig' %}

{% block title %}À propos - Portfolio{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/apropos.css') }}">
{% endblock %}

{% block body %}
    <h1 class="mb-4">À propos de moi</h1>

    {% if profil and profil.bio %}
        <p class="bio-texte mb-5">{{ profil.bio }}</p>
    {% else %}
        <p class="text-secondary mb-5">Aucune biographie renseignée pour le moment.</p>
    {% endif %}

    <h2 class="h4 mb-3">Compétences</h2>

    {% set categories = competences|map(c => c.categorie)|reduce((acc, item) => item in acc ? acc : acc|merge([item]), []) %}

    {% if categories is empty %}
        <p class="text-secondary">Aucune compétence renseignée.</p>
    {% else %}
        {% for categorie in categories %}
            <div class="competence-categorie">
                <h3>{{ categorie }}</h3>
                <div class="competences-liste">
                    {% for competence in competences %}
                        {% if competence.categorie == categorie %}
                            <span class="competence-badge">{{ competence.nom }}</span>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    {% endif %}
{% endblock %}