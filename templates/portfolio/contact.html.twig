{% extends 'base.html.twig' %}

{% block title %}Contact - Portfolio{% endblock %}

{% block body %}
    <h1>Me contacter</h1>

    {% for message in app.flashes('success') %}
        <div style="background-color: #23863633; color: #7ee787; padding: 12px 18px; border-radius: 8px; margin: 20px 0;">
            {{ message }}
        </div>
    {% endfor %}

    <div style="max-width: 500px; margin-top: 20px;">
        {{ form_start(form) }}
            <div style="margin-bottom: 15px;">
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom, {attr: {style: 'width:100%; padding:10px; border-radius:8px; background:#161b22; border:1px solid #30363d; color:#e6edf3;'}}) }}
            </div>
            <div style="margin-bottom: 15px;">
                {{ form_label(form.email) }}
                {{ form_widget(form.email, {attr: {style: 'width:100%; padding:10px; border-radius:8px; background:#161b22; border:1px solid #30363d; color:#e6edf3;'}}) }}
            </div>
            <div style="margin-bottom: 15px;">
                {{ form_label(form.contenu) }}
                {{ form_widget(form.contenu, {attr: {style: 'width:100%; padding:10px; border-radius:8px; background:#161b22; border:1px solid #30363d; color:#e6edf3; min-height:120px;'}}) }}
            </div>
            <button type="submit" style="background-color: #238636; color: white; border: none; padding: 10px 24px; border-radius: 8px; cursor: pointer;">Envoyer</button>
        {{ form_end(form) }}
    </div>
{% endblock %}