{% extends 'base.html.twig' %}

{% block title %}Détail du Projet{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
{% endblock %}

{% block body %}
    <div class="admin-header">
        <h1 class="h3 mb-0">Projet #{{ projet.id }}</h1>
        <a href="{{ path('app_projet_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
    </div>

    <div class="show-panel mb-3">
        <table>
            <tbody>
                <tr><th>Id</th><td>{{ projet.id }}</td></tr>
                <tr><th>Titre</th><td>{{ projet.titre }}</td></tr>
                <tr><th>Description</th><td>{{ projet.description }}</td></tr>
                <tr><th>Catégorie</th><td>{{ projet.categorie }}</td></tr>
                <tr><th>Lien</th><td>{{ projet.lien }}</td></tr>
                <tr><th>Technologies</th><td>{{ projet.technologies }}</td></tr>
                <tr><th>Date création</th><td>{{ projet.dateCreation ? projet.dateCreation|date('d/m/Y') : '' }}</td></tr>
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_projet_edit', {'id': projet.id}) }}" class="btn btn-primary">Modifier</a>
{% endblock %}