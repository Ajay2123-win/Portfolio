<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Mon Portfolio{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% set profil = profil_actuel() %}

    <aside class="sidebar">
        {% if profil %}
            <img src="{{ profil.photo ? asset('uploads/photos/' ~ profil.photo) : asset('css/default-avatar.png') }}" alt="Photo de profil">
            <h2>{{ profil.prenom }} {{ profil.nom }}</h2>
            <div class="titre-poste">{{ profil.titre }}</div>

            <div class="info-block">
                <label>Email</label>
                <div class="valeur">{{ profil.email }}</div>
            </div>

            {% if profil.telephone %}
            <div class="info-block">
                <label>Téléphone</label>
                <div class="valeur">{{ profil.telephone }}</div>
            </div>
            {% endif %}

            {% if profil.localisation %}
            <div class="info-block">
                <label>Localisation</label>
                <div class="valeur">{{ profil.localisation }}</div>
            </div>
            {% endif %}

            {% if profil.lienProjetDeploye %}
            <div class="info-block">
                <label>Projet déployé</label>
                <div class="valeur"><a href="{{ profil.lienProjetDeploye }}" style="color:inherit" target="_blank">{{ profil.lienProjetDeploye }}</a></div>
            </div>
            {% endif %}
        {% else %}
            <p>Profil non renseigné.</p>
        {% endif %}
    </aside>

    <main class="main-content">
        <div class="navbar">
            <nav>
                <a href="{{ path('app_home') }}">Accueil</a>
                <a href="{{ path('app_projets_public') }}">Projets</a>
                <a href="{{ path('app_parcours_public') }}">Parcours</a>
                <a href="{{ path('app_apropos_public') }}">À propos</a>
                <a href="{{ path('app_contact_public') }}">Contact</a>
            </nav>
            <button class="theme-toggle" id="themeToggle">🌙 Mode sombre</button>
        </div>

        {% block body %}{% endblock %}
    </main>

    <script>
        const toggle = document.getElementById('themeToggle');
        const body = document.body;

        if (localStorage.getItem('theme') === 'light') {
            body.classList.add('light-mode');
            toggle.textContent = '☀️ Mode clair';
        }

        toggle.addEventListener('click', () => {
            body.classList.toggle('light-mode');
            const isLight = body.classList.contains('light-mode');
            localStorage.setItem('theme', isLight ? 'light' : 'dark');
            toggle.textContent = isLight ? '☀️ Mode clair' : '🌙 Mode sombre';
        });
    </script>

    {% block javascripts %}{% endblock %}
</body>
</html>