<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Mon Portfolio{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="{{ asset('css/base.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% set profil = profil_actuel() %}

    <div class="container-fluid p-0">
        <div class="row g-0">

            <aside class="col-lg-3 col-xl-2 sidebar p-4">
                {% if profil %}
                    <div class="text-center">
                        <img src="{{ profil.photo ? asset('uploads/photos/' ~ profil.photo) : asset('css/default-avatar.png') }}"
                             alt="Photo de profil" class="rounded-3 mb-3" style="width: 140px; height: 140px; object-fit: cover;">
                        <h5 class="mb-1">{{ profil.prenom }} {{ profil.nom }}</h5>
                        <span class="badge rounded-pill titre-poste mb-4">{{ profil.titre }}</span>
                    </div>

                    <div class="info-block mb-3">
                        <label class="text-uppercase small text-secondary">Email</label>
                        <div class="valeur small">{{ profil.email }}</div>
                    </div>

                    {% if profil.telephone %}
                    <div class="info-block mb-3">
                        <label class="text-uppercase small text-secondary">Téléphone</label>
                        <div class="valeur small">{{ profil.telephone }}</div>
                    </div>
                    {% endif %}

                    {% if profil.localisation %}
                    <div class="info-block mb-3">
                        <label class="text-uppercase small text-secondary">Localisation</label>
                        <div class="valeur small">{{ profil.localisation }}</div>
                    </div>
                    {% endif %}

                    {% if profil.lienProjetDeploye %}
                    <div class="info-block mb-3">
                        <label class="text-uppercase small text-secondary">Projet déployé</label>
                        <div class="valeur small text-truncate">
                            <a href="{{ profil.lienProjetDeploye }}" class="text-decoration-none text-reset" target="_blank">{{ profil.lienProjetDeploye }}</a>
                        </div>
                    </div>
                    {% endif %}

                    <div class="d-flex gap-3 justify-content-center mt-4">
                        {% if profil.lienGithub %}
                            <a href="{{ profil.lienGithub }}" class="text-reset" target="_blank"><i class="bi bi-github fs-5"></i></a>
                        {% endif %}
                        {% if profil.lienLinkedin %}
                            <a href="{{ profil.lienLinkedin }}" class="text-reset" target="_blank"><i class="bi bi-linkedin fs-5"></i></a>
                        {% endif %}
                    </div>
                {% else %}
                    <p>Profil non renseigné.</p>
                {% endif %}
            </aside>

            <main class="col-lg-9 col-xl-10 main-content p-4 p-lg-5">
                <nav class="navbar navbar-expand-lg mb-4">
                    <div class="container-fluid px-0 d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div class="d-flex gap-4">
                            <a href="{{ path('app_home') }}" class="nav-link-custom">Accueil</a>
                            <a href="{{ path('app_projets_public') }}" class="nav-link-custom">Projets</a>
                            <a href="{{ path('app_parcours_public') }}" class="nav-link-custom">Parcours</a>
                            <a href="{{ path('app_apropos_public') }}" class="nav-link-custom">À propos</a>
                            <a href="{{ path('app_contact_public') }}" class="nav-link-custom">Contact</a>
                        </div>
                        <button class="theme-toggle btn rounded-pill" id="themeToggle"><i class="bi bi-moon-stars me-1"></i> Mode sombre</button>
                    </div>
                </nav>

                {% block body %}{% endblock %}
            </main>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const toggle = document.getElementById('themeToggle');
        const body = document.body;

if (localStorage.getItem('theme') === 'light') {
    body.classList.add('light-mode');
    toggle.innerHTML = '<i class="bi bi-sun me-1"></i> Mode clair';
}

toggle.addEventListener('click', () => {
    body.classList.toggle('light-mode');
    const isLight = body.classList.contains('light-mode');
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
    toggle.innerHTML = isLight
        ? '<i class="bi bi-sun me-1"></i> Mode clair'
        : '<i class="bi bi-moon-stars me-1"></i> Mode sombre';
});
    </script>

    {% block javascripts %}{% endblock %}
</body>
</html>