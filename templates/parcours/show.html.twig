{% extends 'base.html.twig' %}

{% block title %}Parcours{% endblock %}

{% block body %}
    <h1>Parcours</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ parcour.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ parcour.titre }}</td>
            </tr>
            <tr>
                <th>Etablissement</th>
                <td>{{ parcour.etablissement }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ parcour.description }}</td>
            </tr>
            <tr>
                <th>DateDebut</th>
                <td>{{ parcour.dateDebut ? parcour.dateDebut|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DateFin</th>
                <td>{{ parcour.dateFin ? parcour.dateFin|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ parcour.type }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_parcours_index') }}">back to list</a>

    <a href="{{ path('app_parcours_edit', {'id': parcour.id}) }}">edit</a>

    {{ include('parcours/_delete_form.html.twig') }}
{% endblock %}
