{% extends 'base.html.twig' %}

{% block title %}Détail du Parcours{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
{% endblock %}

{% block body %}
    <div class="admin-header">
        <h1 class="h3 mb-0">Parcours #{{ parcour.id }}</h1>
        <a href="{{ path('app_parcours_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
    </div>

    <div class="show-panel mb-3">
        <table>
            <tbody>
                <tr><th>Id</th><td>{{ parcour.id }}</td></tr>
                <tr><th>Titre</th><td>{{ parcour.titre }}</td></tr>
                <tr><th>Établissement</th><td>{{ parcour.etablissement }}</td></tr>
                <tr><th>Description</th><td>{{ parcour.description }}</td></tr>
                <tr><th>Type</th><td>{{ parcour.type }}</td></tr>
                <tr><th>Date début</th><td>{{ parcour.dateDebut ? parcour.dateDebut|date('d/m/Y') : '' }}</td></tr>
                <tr><th>Date fin</th><td>{{ parcour.dateFin ? parcour.dateFin|date('d/m/Y') : 'En cours' }}</td></tr>
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_parcours_edit', {'id': parcour.id}) }}" class="btn btn-primary">Modifier</a>
{% endblock %}