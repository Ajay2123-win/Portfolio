{% extends 'base.html.twig' %}

{% block title %}Gestion du Parcours{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
{% endblock %}

{% block body %}
    <div class="admin-header">
        <h1 class="h3 mb-0">Parcours</h1>
        <a href="{{ path('app_parcours_new') }}" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Nouvelle étape
        </a>
    </div>

    <div class="table-responsive">
        <table class="table-admin">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Titre</th>
                    <th>Établissement</th>
                    <th>Type</th>
                    <th>Début</th>
                    <th>Fin</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for parcour in parcours %}
                <tr>
                    <td>{{ parcour.id }}</td>
                    <td>{{ parcour.titre }}</td>
                    <td>{{ parcour.etablissement }}</td>
                    <td>{{ parcour.type }}</td>
                    <td>{{ parcour.dateDebut ? parcour.dateDebut|date('m/Y') : '' }}</td>
                    <td>{{ parcour.dateFin ? parcour.dateFin|date('m/Y') : 'En cours' }}</td>
                    <td>
                        <div class="actions-cell">
                            <a href="{{ path('app_parcours_show', {'id': parcour.id}) }}" class="btn btn-outline-secondary btn-sm">Voir</a>
                            <a href="{{ path('app_parcours_edit', {'id': parcour.id}) }}" class="btn btn-outline-primary btn-sm">Modifier</a>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" class="text-center text-secondary">Aucune étape trouvée</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}