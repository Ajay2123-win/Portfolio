{% extends 'base.html.twig' %}

{% block title %}Gestion des Compétences{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
{% endblock %}

{% block body %}
    <div class="admin-header">
        <h1 class="h3 mb-0">Compétences</h1>
        <a href="{{ path('app_competence_new') }}" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Nouvelle compétence
        </a>
    </div>

    <div class="table-responsive">
        <table class="table-admin">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nom</th>
                    <th>Catégorie</th>
                    <th>Niveau</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for competence in competences %}
                <tr>
                    <td>{{ competence.id }}</td>
                    <td>{{ competence.nom }}</td>
                    <td>{{ competence.categorie }}</td>
                    <td>{{ competence.niveau }}</td>
                    <td>
                        <div class="actions-cell">
                            <a href="{{ path('app_competence_show', {'id': competence.id}) }}" class="btn btn-outline-secondary btn-sm">Voir</a>
                            <a href="{{ path('app_competence_edit', {'id': competence.id}) }}" class="btn btn-outline-primary btn-sm">Modifier</a>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="text-center text-secondary">Aucune compétence trouvée</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}